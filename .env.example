# Copy to .env and fill in. Never commit .env.
#
# Local dev: `bun run dev` runs Vite + the contact API (Bun on port 3001). Use `bun run dev:site`
# if you only need the frontend. https://bun.sh
#
# Client (Vite) — set at build time for canonical URLs, sitemap, and JSON-LD.
# Example: https://yourdomain.com  (no trailing slash)
# VITE_SITE_URL=https://yourdomain.com
#
# Resend: https://resend.com/api-keys
# Replace re_xxxxxxxxx with your real API key.
RESEND_API_KEY=re_xxxxxxxxx

# Inbox that receives contact form submissions
CONTACT_INBOX_EMAIL=you@example.com

# Sender — use a domain you verified in Resend, or onboarding@resend.dev for testing
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional: contact API port (default 3001)
# PORT=3001

# Optional: if the contact API is hosted elsewhere in production (no trailing slash).
# On Cloudflare Pages, leave this unset so the form POSTs to same-origin /api/contact.
#
# Cloudflare Pages build: Settings → Builds & deployments — build output `dist`, and leave
# the optional "Deploy command" blank (never `wrangler deploy`; that is for Workers only).
#
# Cloudflare production (same binding names as in code):
# - From this file: fill .env below, then `bun run cf:login` once and:
#     bun run cf:secrets:push
#   That uploads only RESEND_API_KEY, CONTACT_INBOX_EMAIL, and RESEND_FROM_EMAIL (if set).
#   Override project: CF_PAGES_PROJECT=my-pages-slug bun run cf:secrets:push
# - Or set one at a time: `bun run cf:secret:put -- RESEND_API_KEY`
# - List: `bun run cf:secrets:list`
# - Default Pages project name is `portfolio` (see wrangler.toml); change package.json scripts if needed.
# - RESEND_FROM_EMAIL can instead be plain Text in the dashboard if you prefer.
# - Never store API keys in wrangler.toml [vars].
# Local Pages + Functions: copy .dev.vars.example → .dev.vars, then bun run cf:pages:dev
# VITE_CONTACT_API_BASE=https://api.yoursite.com
