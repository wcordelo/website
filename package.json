{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n site,api -c cyan,magenta \"vite\" \"bun run dev:api\"",
    "dev:site": "vite",
    "dev:api": "bun run server/contact-api.ts",
    "build": "tsc -b && vite build",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "cf:login": "wrangler login",
    "cf:secrets:list": "wrangler pages secret list --project-name $(bun run scripts/cf-pages-project.ts)",
    "cf:secret:put": "wrangler pages secret put --project-name $(bun run scripts/cf-pages-project.ts)",
    "cf:secrets:push": "bun run scripts/push-pages-secrets.ts",
    "cf:worker:secrets:push": "bun run scripts/push-pages-secrets.ts --worker",
    "cf:worker:secrets:list": "wrangler secret list",
    "cf:worker:secret:put": "wrangler secret put",
    "cf:worker:deploy": "bun run build && wrangler deploy",
    "cf:ci:deploy": "wrangler deploy",
    "cf:pages:dev": "bun run build && wrangler pages dev dist",
    "dev:e2e": "concurrently -k -n api,site -c magenta,cyan \"bun run dev:api\" \"bun run dev:site -- --host 127.0.0.1 --port 5173 --strictPort\"",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report e2e/artifacts/playwright-report"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@cloudflare/vite-plugin": "^1.33.0",
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "agentation": "^3.0.2",
    "concurrently": "^9.2.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.9",
    "wrangler": "^4.84.0"
  }
}
