{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bgit.dev/schema/intent/v0.1",
  "title": "bgit Session Intent",
  "description": "GIT-001: Structured intent for agent sessions",
  "type": "object",
  "required": ["session_id", "agent", "user", "intent", "started_at", "checkpoints", "status"],
  "properties": {
    "session_id": { "type": "string", "pattern": "^sess_[a-z0-9]+$" },
    "agent": { "type": "string" },
    "user": { "type": "string" },
    "intent": { "type": "string", "minLength": 1 },
    "issue_ref": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "checkpoints": { "type": "array", "items": { "type": "string" } },
    "final_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "head_at_start": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "ended"] }
  },
  "additionalProperties": false
}
